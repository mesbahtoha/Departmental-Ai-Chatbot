{
  "name": "ai-chatbot-backend",
  "version": "2.0.0",
  "description": "Production-ready AI Chatbot API - modular, scalable, secure (Express + MongoDB + OpenRouter)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "vercel-build": "npm run build"
  },
  "keywords": [
    "chatbot",
    "ai",
    "backend",
    "express",
    "mongodb",
    "typescript",
    "openrouter"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "tsx": "^4.19.2",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@vercel/edge": "^1.3.2",
    "nodemon": "^3.1.0",
    "typescript": "^5.7.2"
  }
}
