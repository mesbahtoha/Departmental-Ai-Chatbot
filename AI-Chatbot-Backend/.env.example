# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TITLE=AI Chatbot
CORS_ORIGIN=*

# MongoDB
DB_NAME=ChatBot_DB
MONGO_URI=mongodb://localhost:27017
VECTOR_INDEX_NAME=notice_vector_index

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_TOKENS=700

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seeded admin account (created on first boot)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Per-user AI token quotas (0 = unlimited)
DAILY_QUOTA_PER_USER=40000
MONTHLY_QUOTA_PER_USER=0

# SMTP (password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Chatbot <no-reply@example.com>
